	@Override
	public void keyPressed(KeyEvent e) {
		
		int keyCode = e.getKeyCode();
		
		if ( keyCode == KeyEvent.VK_RIGHT )
		{			
			yRot+=10;	 
		}
		if ( keyCode == KeyEvent.VK_LEFT )
		{
			yRot-=10;	 
		}
		if ( keyCode == KeyEvent.VK_UP )
		{
			xRot+=10;	 
		}
		if ( keyCode == KeyEvent.VK_DOWN )
		{
			xRot-=10;	 
		}
		
	}


	@Override
	public void keyReleased(KeyEvent arg0) {
		// TODO Auto-generated method stub
		
	}


	@Override
	public void keyTyped(KeyEvent e) {

		
		
		if ( e.getKeyChar()=='0' )
		{
			channelArray[0].enabled = !channelArray[0].enabled;
		}
		
		if ( e.getKeyChar()=='1' )
		{
			channelArray[1].enabled = !channelArray[1].enabled;
		}
		
		if ( e.getKeyChar()=='+' )
		{
			System.out.println("Translate x+");
			channelArray[1].translation.x+=1;	 
		}
		if ( e.getKeyChar()=='-' )
		{
			System.out.println("Translate x-");
			channelArray[1].translation.x-=1;	 
		}
		
		
		if ( e.getKeyChar()=='/' )
		{
			skipper--;
			if ( skipper < 1 )
			{
				skipper = 1;
			}
		}
		if ( e.getKeyChar()=='*' )
		{
			skipper++;	 
		}
	}
    
